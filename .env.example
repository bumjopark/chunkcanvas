# ChunkCanvas configuration. Copy to .env and adjust. Every setting is optional.

# --- Public deployment ---------------------------------------------------------------
# Public URL of the demo. Plain-HTTP requests forwarded by a trusted proxy redirect here.
# CC_PUBLIC_ORIGIN=https://chunkcanvas.example.com
# Host names the server answers to (comma separated). Add your public domain.
CC_ALLOWED_HOSTS=localhost,127.0.0.1
# Read the visitor IP from the one selected proxy header for rate limits. Enable only
# when the app is reachable solely through your reverse proxy or tunnel.
CC_TRUST_PROXY_HEADERS=false
# Cloudflare Tunnel: cf-connecting-ip. nginx/Caddy: x-forwarded-for (overwrite at the proxy).
CC_PROXY_IP_HEADER=cf-connecting-ip
# Allow the Cloudflare Web Analytics beacon if your Cloudflare zone injects it.
CC_CSP_ALLOW_CLOUDFLARE_INSIGHTS=false

# --- Limits -------------------------------------------------------------------------------
CC_MAX_UPLOAD_MB=10
CC_MAX_PAGES=30
CC_MAX_OCR_PAGES=10
# true: longer PDFs are cut to their first CC_MAX_PAGES pages instead of being rejected.
CC_TRUNCATE_LONG_PDFS=false
# Repository link shown with the truncation notice and on the start page.
# CC_REPO_URL=https://github.com/bumjopark/chunkcanvas
# Uploaded files, parse results and edits are deleted after this many seconds.
CC_DOCUMENT_TTL_SECONDS=3600
CC_MAX_QUEUED_JOBS=20
CC_MAX_ACTIVE_DOCUMENTS_PER_CLIENT=5
CC_MAX_SAMPLE_DOCUMENTS_PER_CLIENT=20
CC_MAX_STORED_DOCUMENTS=1000
CC_MAX_STORED_SAMPLE_DOCUMENTS=200
CC_INSPECTION_CONCURRENCY=1
CC_UPLOAD_TIMEOUT_SECONDS=120
CC_UPLOAD_IDLE_SECONDS=15
CC_UPLOAD_GRACE_SECONDS=10
CC_UPLOAD_MIN_BYTES_PER_SECOND=4096
CC_MAX_UPLOADS_IN_PROGRESS=32
CC_MAX_UPLOADS_IN_PROGRESS_PER_CLIENT=2
# Uploads in progress from one wider network (an IPv6 /48 by default, else the IPv4 address).
CC_MAX_UPLOADS_IN_PROGRESS_PER_NETWORK=4
CC_UPLOADS_PER_CLIENT_PER_HOUR=20
CC_SAMPLES_PER_CLIENT_PER_HOUR=60
# Group IPv6 privacy addresses within a subnet. Shared networks share these limits;
# use 128 only when per-address limits are appropriate for your deployment.
CC_IPV6_RATE_PREFIX=56
CC_IPV6_NETWORK_PREFIX=48
CC_REQUESTS_PER_CLIENT_PER_MINUTE=600

# --- Parsing -----------------------------------------------------------------------------
# hybrid (Docling layout + PyMuPDF text layer, ~5 s/page on CPU), docling, or pymupdf (fast heuristics).
CC_DEFAULT_PARSER=hybrid
# Parallel parse jobs. Each Docling job needs up to about 2 GB of RAM.
CC_WORKER_CONCURRENCY=1
CC_JOB_TIMEOUT_SECONDS=900
# Docling table model: fast (about half the CPU time on table-heavy papers) or accurate.
CC_TABLE_MODE=fast
CC_PARSER_THREADS=4
# bwrap runs every conversion and parse in a bubblewrap sandbox without network that can only see its
# own document (Linux hosts). Required for public hosting: converters follow links inside documents.
# none is for trusted local input only. No automatic fallback to none.
CC_PARSER_SANDBOX=bwrap
# LibreOffice for non-PDF uploads (Office, HWP/HWPX, HTML, Markdown, text, CSV). Found automatically
# in .tools/libreoffice or on PATH; without it only PDFs and images are accepted.
# CC_SOFFICE=/srv/chunkcanvas/.tools/libreoffice-26.2.7.3/opt/libreoffice26.2/program/soffice
CC_CONVERT_TIMEOUT_SECONDS=150
# Offer the experimental CPU OCR parser (RapidOCR) for scanned PDFs.
CC_OCR_ENABLED=true
# Hybrid parser: also OCR pictures inside digital documents (slower on image-heavy decks).
CC_OCR_PICTURES=true
# Display formulas are read from their image as LaTeX (pix2text-mfr on CPU, ~1-2 s each) for at
# most this many seconds per document; 0 keeps text-layer math only.
CC_FORMULA_SECONDS=300

# --- AI picture reading (optional) -----------------------------------------------------------
# A provider key plus CC_API_PWD offers password access. With CC_VLM_OPEN=true, anyone
# can opt in for their next upload. Selected picture crops, their captions and part of the
# preceding paragraph go to the provider using the operator's key. Set a daily image cap
# and a spending or usage limit at the provider before opening access.
# Keep CC_API_PWD set to switch back with CC_VLM_OPEN=false and a service restart.
CC_VLM_OPEN=false
# CC_OPENAI_API_KEY=sk-...
# CC_API_PWD=choose-a-password
# CC_VLM_MODEL=gpt-6-luna
# CC_VLM_REASONING_EFFORT=low
# CC_VLM_MAX_FIGURES=80
# CC_VLM_SECONDS=300
# CC_VLM_CONCURRENCY=8
# Optional ceiling on pictures sent per day (0: none).
# CC_VLM_DAILY_IMAGES=0

# --- Paths (use absolute overrides; defaults are based on the repository location) ---------------------------------------
# CC_DATA_DIR=/srv/chunkcanvas/data
# CC_MODELS_DIR=/srv/chunkcanvas/services/api/.models
# Built frontend to serve from the API (apps/web/dist). Leave unset when using `npm run dev`.
# CC_WEB_DIST=/srv/chunkcanvas/apps/web/dist
